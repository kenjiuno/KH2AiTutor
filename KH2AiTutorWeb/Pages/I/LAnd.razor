@page "/i/land"

<RenderIntBinaryOp NewName="land"
                   OldName="land"
                   CalcNewTP0="(TP0, TP1) => ((TP0 != 0) && (TP1 != 0)) ? 1 : 0"
                   Hint="push a; push b; (a && b)"
                   TP0="@TP0" TP1="@TP1" />

@code {
    [SupplyParameterFromQuery(Name = "tp0")] int TP0 { get; set; }
    [SupplyParameterFromQuery(Name = "tp1")] int TP1 { get; set; }

    protected override void OnInitialized()
    {
        TP0 = (TP0 == default) ? 1 : TP0;
        TP1 = (TP1 == default) ? 1 : TP1;
    }
}
