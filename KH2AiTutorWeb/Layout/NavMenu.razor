@using KH2AiTutorWeb.Helpers
@inject IEnumerable<HrefAndDisplayGroup> _hrefAndDisplayGroups

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">KH2AiTutor</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        @foreach (var group in _hrefAndDisplayGroups)
        {
            foreach (var item in group.Links)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@item.Href">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> @item.Display
                    </NavLink>
                </div>
            }
        }
    </nav>
</div>
