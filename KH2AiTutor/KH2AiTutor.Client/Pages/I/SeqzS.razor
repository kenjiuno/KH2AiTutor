@page "/i/seqz.s"

<RenderSetSOp NewName="seqz.s"
              OldName="eqzf"
              CalcNewTP0="TP0 => ((TP0 == 0) ? 1 : 0)"
              Hint="set 1 if: equal to 0"
              TP0="@TP0" />

@code {
    [SupplyParameterFromQuery(Name = "tp0")] float TP0 { get; set; }

    protected override void OnInitialized()
    {
        TP0 = (TP0 == default) ? 0 : TP0;
    }
}
