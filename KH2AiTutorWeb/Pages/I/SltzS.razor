@page "/i/sltz.s"

<RenderSetSOp NewName="sltz.s"
              OldName="infzf"
              CalcNewTP0="TP0 => ((TP0 < 0) ? 1 : 0)"
              Hint="set 1 if: less than 0 (negative)"
              TP0="@TP0" />

@code {
    [SupplyParameterFromQuery(Name = "tp0")] float TP0 { get; set; }

    protected override void OnInitialized()
    {
        TP0 = (TP0 == default) ? 0 : TP0;
    }
}
