@using KH2AiTutor.Client.Helpers
@if (_hasPops)
{
    <table>
        <tbody>
            <tr>
                <td></td>
                <td></td>
                @foreach (var _ in Enumerable.Repeat("", _numPops))
                {
                    <td></td>
                }
                <td>tp</td>
            </tr>
            <tr>
                <th class="memory-name">temp memory:</th>
                <td class="tp-here future-gray">|<br />|</td>
                @foreach (var item in _pops)
                {
                    <td class="stack-item">@item</td>
                }
                <td class="tp-here">|<br />|</td>
                <td class="stack-item">...</td>
            </tr>
            <tr>
                <td></td>
                <td class="future-gray">①</td>
                <td class="future-gray">tp move here</td>
            </tr>
        </tbody>
    </table>
}
@if (_hasPushes)
{
    <table>
        <tbody>
            <tr>
                <td></td>
                <td>tp</td>
                @foreach (var _ in Enumerable.Repeat("", _numPushes))
                {
                    <td></td>
                }
                <td class="future-gray">@_newTpNumbering</td>
                <td class="future-gray">tp move here</td>
            </tr>
            <tr>
                <th class="memory-name">temp memory:</th>
                <td class="tp-here">|<br />|</td>
                @foreach (var item in _pushes)
                {
                    <td class="stack-item">@(item.Numbering) set @(item.Display)</td>
                }
                <td class="tp-here future-gray">|<br />|</td>
                <td class="stack-item">...</td>
            </tr>
        </tbody>
    </table>
}

@code {
    [Parameter] public string? Pops { get; set; }
    [Parameter] public string? Pushes { get; set; }
    private string[] _pops = Array.Empty<string>();
    private int _numPops;
    private bool _hasPops;
    private PushPair[] _pushes = Array.Empty<PushPair>();
    private int _numPushes;
    private bool _hasPushes;
    private CircleNumber _circleNum = new();
    private record PushPair(string Numbering, string Display);
    private string _newTpNumbering = "";

    private void Recalc()
    {
        _pops = GetPops().ToArray();
        _numPops = _pops.Length;
        _hasPops = _numPops != 0;

        var pushes = GetPushes().ToArray();
        _numPushes = pushes.Length;
        _hasPushes = _numPushes != 0;
        _pushes = pushes.Select(
            (item, index) => new PushPair(
                _circleNum.Of(1 + (_hasPops ? 1 : 0) + index),
                item
            )
        )
            .ToArray();

        _newTpNumbering = _circleNum.Of(
            1 + (_hasPops ? 1 : 0) + _numPushes
        );
    }

    private IEnumerable<string> GetPops() => (Pops ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    private IEnumerable<string> GetPushes() => (Pushes ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    protected override void OnInitialized()
    {
    }

    protected override void OnParametersSet()
    {
        Recalc();
        StateHasChanged();
    }
}
