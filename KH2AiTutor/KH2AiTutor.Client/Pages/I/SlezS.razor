@page "/i/slez.s"

<RenderSetSOp NewName="slez.s"
              OldName="infoezf"
              CalcNewTP0="TP0 => ((TP0 <= 0) ? 1 : 0)"
              Hint="set 1 if: less than or equal to 0 (negative and zero)"
              TP0="@TP0" />

@code {
    [SupplyParameterFromQuery(Name = "tp0")] float TP0 { get; set; }

    protected override void OnInitialized()
    {
        TP0 = (TP0 == default) ? 0 : TP0;
    }
}
