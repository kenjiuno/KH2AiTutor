@page "/i/push.d.bd"

<PageTitle>push.d.bd (pushFromFAi)</PageTitle>

<div class="card">
    <div class="card-header">push.d.bd instruction</div>
    <div class="card-body">
        <table>
            <tbody>
                <tr>
                    <td></td>
                    <td>bd</td>
                    <td></td>
                    <td>+@(Arg1 * 2)</td>
                </tr>
                <tr>
                    <th class="memory-name">bd memory: </th>
                    <td class="wp-here">|<br />|<br /></td>
                    <td class="stack-item">...</td>
                    <td class="stack-item">@BD0</td>
                    <td class="stack-item">...</td>
                </tr>
            </tbody>
        </table>
        <table>
            <tbody>
                <tr>
                    <td></td>
                    <td>tp</td>
                    <td></td>
                    <td class="future-gray">②</td>
                    <td class="future-gray">tp move here</td>
                </tr>
                <tr>
                    <th class="memory-name">temp memory:</th>
                    <td class="tp-here">|<br />|</td>
                    <td class="stack-item">① set @(BD0)</td>
                    <td class="tp-here future-gray">|<br />|</td>
                    <td class="stack-item">??</td>
                    <td class="stack-item">??</td>
                    <td class="stack-item">...</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="card mt-1">
    <div class="card-header">arguments</div>
    <div class="card-body">
        <div class="row">
            <div class="col-sm"><Int32Edit Label="BD0" Value="@BD0" OnValue="v => BD0 = v" /></div>
            <div class="col-sm"><Int10Edit Label="Arg1" Value="@Arg1" OnValue="v => Arg1 = v" /></div>
            <div class="col-sm">3 of 4</div>
            <div class="col-sm">4 of 4</div>
        </div>
    </div>
</div>

<div class="card mt-1">
    <div class="card-header">example</div>
    <div class="card-body">
        <pre xml:space="preserve">; push *( bd + int16)

push.d.bd @Arg1
drop ; @BD0</pre>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "arg1")] int Arg1 { get; set; }
    [SupplyParameterFromQuery(Name = "bd0")] int BD0 { get; set; }
    private int PrevArg1;
    private int PrevBD0;

    protected override void OnInitialized()
    {
        Arg1 = (Arg1 == default) ? 500 : Arg1;
        BD0 = (BD0 == default) ? 12345 : BD0;
    }

    private void Recalc()
    {
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (PrevArg1 != Arg1 || PrevBD0 != BD0 || firstRender)
        {
            PrevArg1 = Arg1;
            PrevBD0 = BD0;
            Recalc();
            StateHasChanged();
        }
    }
}
