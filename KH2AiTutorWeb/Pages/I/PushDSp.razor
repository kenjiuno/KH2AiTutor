@page "/i/push.d.sp"

<PageTitle>push.d.sp (pushFromFSp)</PageTitle>

<div class="card">
    <div class="card-header">push.d.sp instruction</div>
    <div class="card-body">
        <table>
            <tbody>
                <tr>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td>sp</td>
                    <td></td>
                    <td>+@Arg1</td>
                </tr>
                <tr>
                    <th class="memory-name">stack memory: </th>
                    <td class="stack-item">...</td>
                    <td class="stack-item">(count)</td>
                    <td class="stack-item">(ret-ip)</td>
                    <td class="sp-here">|<br />|<br /></td>
                    <td class="stack-item">...</td>
                    <td class="stack-item">@SP0</td>
                    <td class="stack-item">...</td>
                </tr>
            </tbody>
        </table>
        <table>
            <tbody>
                <tr>
                    <td></td>
                    <td>tp</td>
                    <td></td>
                    <td class="future-gray">②</td>
                    <td class="future-gray">tp move here</td>
                </tr>
                <tr>
                    <th class="memory-name">temp memory:</th>
                    <td class="tp-here">|<br />|</td>
                    <td class="stack-item">① set @(SP0)</td>
                    <td class="tp-here future-gray">|<br />|</td>
                    <td class="stack-item">??</td>
                    <td class="stack-item">??</td>
                    <td class="stack-item">...</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="card mt-1">
    <div class="card-header">arguments</div>
    <div class="card-body">
        <div class="row">
            <div class="col-sm"><Int32Edit Label="SP0" Value="@SP0" OnValue="v => SP0 = v" /></div>
            <div class="col-sm"><Int10Edit Label="Arg1" Value="@Arg1" OnValue="v => Arg1 = v" /></div>
            <div class="col-sm">3 of 4</div>
            <div class="col-sm">4 of 4</div>
        </div>
    </div>
</div>

<div class="card mt-1">
    <div class="card-header">example</div>
    <div class="card-body">
        <pre xml:space="preserve">; push *( sp + int16)

push.d.sp @Arg1
drop ; @SP0</pre>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "arg1")] int Arg1 { get; set; }
    [SupplyParameterFromQuery(Name = "sp0")] int SP0 { get; set; }
    private int PrevArg1;
    private int PrevSP0;

    protected override void OnInitialized()
    {
        Arg1 = (Arg1 == default) ? 8 : Arg1;
        SP0 = (SP0 == default) ? 10 : SP0;
    }

    private void Recalc()
    {
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (PrevArg1 != Arg1 || PrevSP0 != SP0 || firstRender)
        {
            PrevArg1 = Arg1;
            PrevSP0 = SP0;
            Recalc();
            StateHasChanged();
        }
    }
}
