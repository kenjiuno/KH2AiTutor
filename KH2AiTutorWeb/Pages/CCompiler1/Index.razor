@page "/ccompiler1"
@using KH2AiTutorWeb.Usecases
@using OpenKh.Kh2Bdx.Utils
@using System.Net
@inject CCompileUsecase _ccompile

<PageTitle>C compiler (experimental)</PageTitle>

<h1>C compiler (experimental)</h1>

<p class="text-muted">Compiler uses <code>OpenKh/OpenKh.Kh2Bdx</code>, <code>ANTLR 4 runtime</code>, <code>Claude Sonnet 5.5</code> (<a href="https://github.com/kenjiuno/OpenKh/commits/impl-bdx-c/" target="_blank">commits</a>) and so on</p>

<div class="mt-2">
    <label for="c">C</label>
    <textarea class="form-control font-monospace" rows="7" id="c" @onchange='e => _c = (e.Value + "")'>@_c</textarea>
</div>

<div class="mt-2">
    <label for="bdscript">Output</label>
    <textarea class="form-control font-monospace" rows="9" id="bdscript">@_output</textarea>
</div>

<div class="form-check mt-2">
    <input class="form-check-input" type="checkbox" id="includeHeader" @bind="_toBdscript">
    <label class="form-check-label" for="includeHeader">Provide as a bdscript</label>
</div>

<div class="mt-2">
    <button class="btn btn-primary" @onclick="Compile" accesskey="x">Compile (Alt+X)</button>
</div>

@if (_hasError)
{
    <div class="alert alert-info mt-2">
        <strong>@_errorTitle</strong>
        <textarea class="form-control font-monospace" rows="7">@(_errorMessage)</textarea>
    </div>
}

@code {
    private string _c = "";
    private bool _toBdscript;
    private string _output = "";
    private bool _hasError = false;
    private string _errorTitle = "";
    private string _errorMessage = "";

    private void Compile()
    {
        var output = new StringWriter();

        try
        {
            var result = _ccompile.Compile(_c, output, _toBdscript);

            _output = result.Bdscript;
            _hasError = false;
            _errorTitle = "";
            _errorMessage = "";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _output = "";
            _hasError = true;
            _errorTitle = ex.Message;
            _errorMessage = output + "\n" + ex + "";
            StateHasChanged();
        }
    }
}