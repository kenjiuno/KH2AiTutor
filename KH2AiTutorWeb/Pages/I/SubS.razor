@page "/i/sub.s"

<RenderFloatBinaryOp NewName="sub.s"
                     OldName="subf"
                     CalcNewTP0="(TP0, TP1) => (TP0 - TP1)"
                     Hint="push a; push b; (a - b) float"
                     TP0="@TP0" TP1="@TP1" />

@code {
    [SupplyParameterFromQuery(Name = "tp0")] float TP0 { get; set; }
    [SupplyParameterFromQuery(Name = "tp1")] float TP1 { get; set; }

    protected override void OnInitialized()
    {
        TP0 = (TP0 == default) ? 128 : TP0;
        TP1 = (TP1 == default) ? 10 : TP1;
    }
}
