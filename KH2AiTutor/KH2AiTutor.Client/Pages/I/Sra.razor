@page "/i/sra"

<RenderIntBinaryOp NewName="sra"
                   OldName="sra"
                   CalcNewTP0="(TP0, TP1) => (int)(TP0 >> TP1)"
                   Hint="Shift right arithmetic (signed)"
                   TP0="@TP0" TP1="@TP1" />

@code {
    [SupplyParameterFromQuery(Name = "tp0")] int TP0 { get; set; }
    [SupplyParameterFromQuery(Name = "tp1")] int TP1 { get; set; }

    protected override void OnInitialized()
    {
        TP0 = (TP0 == default) ? 128 : TP0;
        TP1 = (TP1 == default) ? 2 : TP1;
    }
}
