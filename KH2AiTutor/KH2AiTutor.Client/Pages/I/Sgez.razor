@page "/i/sgez"

<RenderSetOp NewName="sgez"
             OldName="msbi"
             CalcNewTP0="TP0 => ((TP0 >= 0) ? 1 : 0)"
             Hint="set 1 if: greater than or equal to 0 (zero and positive)"
             TP0="@TP0" />

@code {
    [SupplyParameterFromQuery(Name = "tp0")] int TP0 { get; set; }

    protected override void OnInitialized()
    {
        TP0 = (TP0 == default) ? 0 : TP0;
    }
}
