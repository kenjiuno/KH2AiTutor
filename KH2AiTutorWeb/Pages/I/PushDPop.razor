@page "/i/push.d.pop"

<PageTitle>push.d.pop (fetchValue)</PageTitle>

<div class="card">
    <div class="card-header">push.d.pop instruction</div>
    <div class="card-body">
        <table>
            <tbody>
                <tr>
                    <td></td>
                    <td>at</td>
                    <td></td>
                    <td>@(TP0 + Arg1)</td>
                </tr>
                <tr>
                    <th class="memory-name">memory: </th>
                    <td class="m-here">|<br />|<br /></td>
                    <td class="stack-item">...</td>
                    <td class="stack-item">@Mem0</td>
                    <td class="stack-item">...</td>
                </tr>
            </tbody>
        </table>
        <table>
            <tbody>
                <tr>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td>tp</td>
                </tr>
                <tr>
                    <th class="memory-name">temp memory:</th>
                    <td class="tp-here future-gray">|<br />|</td>
                    <td class="stack-item">@TP0</td>
                    <td class="tp-here">|<br />|</td>
                    <td class="stack-item">...</td>
                </tr>
                <tr>
                    <td></td>
                    <td class="future-gray">①</td>
                    <td class="future-gray">tp move here</td>
                </tr>
            </tbody>
        </table>
        <table>
            <tbody>
                <tr>
                    <td></td>
                    <td>tp</td>
                    <td></td>
                    <td class="future-gray">③</td>
                    <td class="future-gray">tp move here</td>
                </tr>
                <tr>
                    <th class="memory-name">temp memory:</th>
                    <td class="tp-here">|<br />|</td>
                    <td class="stack-item">② set @(Mem0)</td>
                    <td class="tp-here future-gray">|<br />|</td>
                    <td class="stack-item">...</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="card mt-1">
    <div class="card-header">arguments</div>
    <div class="card-body">
        <div class="row">
            <div class="col-sm"><Int32Edit Label="TP0" Value="@TP0" OnValue="v => TP0 = v" /></div>
            <div class="col-sm"><Int10Edit Label="Arg1" Value="@Arg1" OnValue="v => Arg1 = v" /></div>
            <div class="col-sm"><Int32Edit Label="Mem0" Value="@Mem0" OnValue="v => Mem0 = v" /></div>
            <div class="col-sm">4 of 4</div>
        </div>
    </div>
</div>


<div class="card mt-1">
    <div class="card-header">example</div>
    <div class="card-body">
        <pre xml:space="preserve">; push *( pop() + int16)

push @TP0
push.d.pop @Arg1
drop ; @Mem0</pre>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "arg1")] int Arg1 { get; set; }
    [SupplyParameterFromQuery(Name = "tp0")] int TP0 { get; set; }
    [SupplyParameterFromQuery(Name = "Mem0")] int Mem0 { get; set; }
    private int PrevArg1;
    private int PrevTP0;
    private int PrevMem0;

    protected override void OnInitialized()
    {
        Arg1 = (Arg1 == default) ? 12 : Arg1;
        TP0 = (TP0 == default) ? 3000 : TP0;
        Mem0 = (Mem0 == default) ? 15 : Mem0;
    }

    private void Recalc()
    {
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (PrevArg1 != Arg1 || PrevTP0 != TP0 || PrevMem0 != Mem0 || firstRender)
        {
            PrevArg1 = Arg1;
            PrevTP0 = TP0;
            PrevMem0 = Mem0;
            Recalc();
            StateHasChanged();
        }
    }
}
