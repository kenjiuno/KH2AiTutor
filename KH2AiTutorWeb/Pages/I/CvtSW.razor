@page "/i/cvt.s.w"

<PageTitle>cvt.s.w (cfti)</PageTitle>

<div class="card">
    <div class="card-header">cvt.s.w instruction</div>
    <div class="card-body">
        <PopAndPushTemp Pops="@($"{DisplayAsInt(TP0)} ({TP0})")"
                        Pushes="@($"{NewTP0}")" />
    </div>
</div>

<div class="card mt-1">
    <div class="card-header">arguments</div>
    <div class="card-body">
        <div class="row">
            <div class="col-sm"><FloatEdit Label="TP0" Value="@TP0" OnValue="v => TP0 = v" /></div>
            <div class="col-sm">2 of 4</div>
            <div class="col-sm">3 of 4</div>
            <div class="col-sm">4 of 4</div>
        </div>
    </div>
</div>

<div class="card mt-1">
    <div class="card-header">example</div>
    <div class="card-body">
        <pre xml:space="preserve">; float to int (convert single to word)

push.s @TP0 ; push @DisplayAsInt(TP0)
cvt.s.w
drop ; @(NewTP0)</pre>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "tp0")] float TP0 { get; set; }
    private float PrevTP0;
    private int NewTP0;

    protected override void OnInitialized()
    {
        TP0 = (TP0 == default) ? 123.456f : TP0;
        Recalc();
    }

    private void Recalc()
    {
        NewTP0 = (int)TP0;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (PrevTP0 != TP0 || firstRender)
        {
            PrevTP0 = TP0;
            Recalc();
            StateHasChanged();
        }
    }

    private int DisplayAsInt(float value)
    {
        return BitConverter.ToInt32(BitConverter.GetBytes(value), 0);
    }
}
